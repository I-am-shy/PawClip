{
  "name": "pawclip-frontend",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node ../test/check-i18n.mjs",
    "check:md": "node ../test/check-md.mjs",
    "check:types": "tsc --noEmit",
    "build": "npm run check:i18n && npm run check:md && npm run check:types && vite build && node scripts/ensure-dist-placeholder.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
